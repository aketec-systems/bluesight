{
  "expo": {
    "name": "Bluesight",
    "slug": "bluesight",
    "scheme": "bluesight",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#170F33",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.bluesight",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used only for Around. Your location is rounded to about 2 km on your phone before it's sent."
      }
    },
    "android": {
      "package": "app.bluesight",
      "adaptiveIcon": {
        "backgroundColor": "#170F33",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Bluesight",
      "themeColor": "#170F33",
      "backgroundColor": "#170F33"
    },
    "plugins": [
      "expo-image",
      [
        "react-native-ble-manager",
        {
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Bluesight uses Bluetooth to find people near you and to chat without using mobile data."
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used only for Around. Your location is rounded to about 2 km on your phone before it's sent."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo. It's shrunk on your phone before it's shared.",
          "cameraPermission": false
        }
      ]
    ]
  }
}
